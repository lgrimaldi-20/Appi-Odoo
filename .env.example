# URL base de tu instancia Odoo (sin barra final)
ODOO_URL=https://tu-odoo.com

# Nombre de la base de datos Odoo
ODOO_DB=tu-db

# Credenciales del usuario de integracion
ODOO_USERNAME=usuario@empresa.com
ODOO_PASSWORD=contraseña

# Entorno de ejecucion. Con ENTORNO=produccion (por defecto) el servicio se
# NIEGA a arrancar sin API_KEY, para que un .env mal desplegado no publique
# el middleware sin autenticacion en silencio. Usa ENTORNO=desarrollo si de
# verdad quieres el modo abierto.
ENTORNO=produccion

# Clave de API para autenticar peticiones al middleware
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=cambia-esta-clave-secreta

# Lista de modelos Odoo permitidos (separados por coma). Vacio = todos.
# Nota: la whitelist solo aplica al endpoint generico /odoo. Los endpoints de
# negocio (/facturas, /pagos, /conciliar, /stock/*) no pasan por ella.
ALLOWED_MODELS=account.move,res.partner,sale.order,purchase.order,stock.picking,product.template,product.product,stock.quant,stock.location

# Lista de metodos Odoo permitidos (separados por coma). Vacio = todos.
# NO anadas "unlink" aqui: /odoo no valida nada, asi que permitiria borrar
# apuntes contables sueltos y dejar asientos descuadrados, saltandose la
# idempotencia y la auditoria. El borrado legitimo va por DELETE /asientos.
ALLOWED_METHODS=search_read,read,fields_get,name_search

# Limites de peticiones por IP. Vacio = se usan estos mismos valores.
# El poller es sincrono y pesado (una pasada de 50 filas tarda ~30 s), asi
# que su limite es deliberadamente mas bajo.
RATE_LIMIT_NEGOCIO=120/minute
RATE_LIMIT_LECTURA=240/minute
RATE_LIMIT_POLLER=6/minute

# Base de datos de CONTROL del middleware (state store: idempotencia, auditoria).
# Por defecto SQLite local (cero infraestructura). En produccion usa PostgreSQL:
#   DATABASE_URL=postgresql://usuario:clave@host:5432/control
# IMPORTANTE: SQLite serializa las escrituras y no soporta FOR UPDATE SKIP
# LOCKED. Vale para desarrollo, pero con varios workers Celery o carga
# concurrente hay que usar PostgreSQL.
DATABASE_URL=sqlite:///./control.db

# Pool de conexiones a la base de CONTROL (se ignoran con SQLite).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cola de tareas (Celery). Si se deja VACIO, las tareas corren en modo eager
# (sincrono inline, sin worker) - util en desarrollo. En produccion usa Redis:
#   CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Poller: cancelar automaticamente en Odoo las facturas que quedaron posteadas
# pero descuadradas (el total de origen no coincide con el que calcula Odoo).
# La validacion corre despues del action_post, asi que sin esto quedaria un
# asiento contable real que nadie dio por bueno. "false" lo desactiva y las
# deja para revision manual en el panel.
POLLER_CANCELAR_DESCUADRE=true

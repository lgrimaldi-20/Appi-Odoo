# URL base de tu instancia Odoo (sin barra final)
ODOO_URL=https://tu-odoo.com

# Nombre de la base de datos Odoo
ODOO_DB=tu-db

# Credenciales del usuario de integracion
ODOO_USERNAME=usuario@empresa.com
ODOO_PASSWORD=contraseña

# Clave de API para autenticar peticiones al middleware
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=cambia-esta-clave-secreta

# Autenticacion FAIL-CLOSED: sin API_KEY el servicio responde 503. Para
# desarrollo local sin clave, ponlo a true de forma explicita (nunca en produccion).
PERMITIR_SIN_API_KEY=

# Limite de peticiones por IP para todas las rutas (slowapi).
RATE_LIMIT_GLOBAL=120/minute

# Lista de modelos Odoo permitidos (separados por coma). Vacio = todos.
# Nota: la whitelist solo aplica al endpoint generico /odoo. Los endpoints de
# negocio (/facturas, /pagos, /conciliar, /stock/*) no pasan por ella.
ALLOWED_MODELS=account.move,res.partner,sale.order,purchase.order,stock.picking,product.template,product.product,stock.quant,stock.location

# Lista de metodos Odoo permitidos (separados por coma). Vacio = todos.
ALLOWED_METHODS=search_read,read,fields_get,name_search,search_count

# Base de datos de CONTROL del middleware (state store: idempotencia, auditoria).
# Por defecto SQLite local (cero infraestructura). En produccion usa PostgreSQL:
#   DATABASE_URL=postgresql://usuario:clave@host:5432/control
DATABASE_URL=sqlite:///./control.db

# Cola de tareas (Celery). Si se deja VACIO, las tareas corren en modo eager
# (sincrono inline, sin worker) - util en desarrollo. En produccion usa Redis:
#   CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Modo PULL (poller): opcional ---
# Base de datos de ORIGEN del cliente, que el middleware sondea en busca de
# filas PENDIENTE en la tabla cola_sincronizacion. VACIO = modo pull apagado
# (no se registra el beat_schedule y /poller/ejecutar responde 400).
#   SOURCE_DATABASE_URL=postgresql://usuario:clave@host:5432/cliente
SOURCE_DATABASE_URL=
POLLER_INTERVALO_SEG=30
POLLER_TENANT=default
POLLER_LIMITE=50

# --- Ingesta desde la API de Smartier (opcional) ---
# API externa de SOLO LECTURA del cliente. Vacio = ingesta apagada.
# La key se genera en el panel de Smartier (seccion API Keys) y necesita
# habilitados los recursos que se vayan a leer.
SMARTIER_BASE_URL=
SMARTIER_API_KEY=
# Cada cuanto lee Celery Beat la API (segundos) y cuantas notas por pasada.
SMARTIER_INTERVALO_SEG=300
SMARTIER_LIMITE=200
# Estados de la nota de entrega que deben facturarse (separados por coma).
SMARTIER_ESTADOS_FACTURAR=Facturada
# Peticiones por segundo (el limite de la API es 5/s por key).
SMARTIER_REQ_POR_SEG=4
